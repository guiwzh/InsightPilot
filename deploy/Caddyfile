{
	servers {
		# 前面还有一层代理（如 Nginx Proxy Manager）时，信任来自内网的上游，保留它传来的 X-Forwarded-For；
		# 公网客户端直连时不在信任范围内，它自带的 X-Forwarded-For 会被丢弃
		trusted_proxies static private_ranges
	}
}

# 站点地址来自环境变量 SITE_ADDRESS：
# - 域名（如 insight.example.com）：Caddy 自动申请并续期 HTTPS 证书
# - :80：只用 HTTP（还没有域名或域名还没解析过来时）
{$SITE_ADDRESS::80} {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# API 交给 Node。对话接口是 SSE，Caddy 遇到 text/event-stream 会立即转发，不会攒着（Nginx 要手动关 proxy_buffering）
	handle /api/* {
		reverse_proxy server:8787
	}

	# 其余都是前端静态文件；找不到的路径回退到 index.html（单页应用）
	handle {
		root * /srv/web
		try_files {path} /index.html
		file_server
	}

	# Vite 产物的文件名带内容哈希，可以长期缓存
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
}
