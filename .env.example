# 复制为 .env 后填写。docker-compose、server、造数脚本都读取这一个文件。

# PostgreSQL 容器
POSTGRES_USER=insightpilot
POSTGRES_PASSWORD=insightpilot_dev
POSTGRES_DB=insightpilot
POSTGRES_PORT=5432

# 管理员连接：drizzle-kit push、造数脚本、应用表（app schema）读写
DATABASE_URL=postgres://insightpilot:insightpilot_dev@localhost:5432/insightpilot
# 只读连接：Agent 生成的 SQL 只走这里。角色和密码在 db/init.sql 中创建，两边要一致
DATABASE_URL_READONLY=postgres://analyst_ro:analyst_ro_dev@localhost:5432/insightpilot

# 模型：在 https://platform.deepseek.com 创建 API key。留空时对话接口进入演示模式（返回固定文本）
DEEPSEEK_API_KEY=
# API 里的模型 ID 不带版本号：deepseek-flash 当前指向 DeepSeek-V4.1-Flash-1017，
# deepseek-v4-pro 指向 DeepSeek-V4-Pro-0813。可用模型以 GET https://api.deepseek.com/models 为准
MODEL_FAST=deepseek-flash
MODEL_STRONG=deepseek-v4-pro

# server 端口（Vite 开发服务器把 /api 代理到这里）
SERVER_PORT=8787
